{
  "name": "electron-ssh-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "SSH Remote Desktop — a fake OS desktop environment running over SSH",
  "scripts": {
    "dev:web": "cd web-app && npm run dev",
    "dev:electron": "cd electron && npm run dev",
    "dev": "concurrently \"npm run dev:web\" \"sleep 3 && npm run dev:electron\"",
    "build:web": "cd web-app && npm run build",
    "build:electron:mac": "cd electron && npm run mac_build",
    "build:electron:win": "cd electron && npm run win_build",
    "start": "cd electron && npm start"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
